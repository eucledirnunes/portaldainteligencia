# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor (ingestão, eventos, editorial, /admin). NUNCA expor no browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- /admin (HTTP Basic). Se não definidos, /admin fica bloqueado (fail closed). ---
ADMIN_USER=
ADMIN_PASSWORD=

# --- Coleta ---
# Identificação do bot. Coloque um contato real.
INGEST_USER_AGENT=BlogDaInteligenciaBot/0.1 (+https://seu-dominio.com.br/bot; contato@seu-dominio.com.br)

# --- Editorial (opcional; sem chave usa geradores básicos, sem LLM) ---
# AI_PROVIDER=openai | anthropic | gemini
AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Publica automaticamente artigos gerados (false = ficam em "review" para revisão humana)
EDITORIAL_AUTO_PUBLISH=false

# --- Imagens de capa (opcional; sem chave, matérias ficam sem capa) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
IMAGE_PROVIDER=openai

# --- Widgets da home (opcionais; sem chave, o widget simplesmente não aparece) ---
# Cotações: twelvedata.com (gratuito, sem cartão)
TWELVE_DATA_API_KEY=
# Clima: openweathermap.org/api, plano Free (permite uso comercial/com anúncios)
OPENWEATHER_API_KEY=

# --- Disparo externo do pipeline (/api/cron/trigger-pipeline) ---
# O cron nativo do GitHub Actions é "best effort" e se mostrou pouco confiável neste
# repositório (<15% dos disparos rodavam). Um serviço externo (ex.: cron-job.org, grátis)
# chama esta rota a cada 15-30 min; ela aciona o workflow via API do GitHub.
# String aleatória longa (ex.: `openssl rand -hex 24`); protege a rota de chamadas de terceiros.
CRON_SECRET=
# GitHub Personal Access Token (fine-grained), só com permissão "Actions: Read and write"
# no repositório portaldainteligencia. Gerado em github.com/settings/tokens?type=beta
GH_TRIGGER_TOKEN=
